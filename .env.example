# Bhrikuty — Environment Variables
# Copy this file to .env and fill in your keys
# Never commit .env to git

# ── SERVER ─────────────────────────────────────────────
# Dashboard/API listen port (server.py) — defaults to 8080 if unset
PORT=8080

# ── REQUIRED — at least ONE of these three (any one is sufficient; see B2V2Docs/architecture.md) ──
# Script generation + text content (generate_phase.py, text_content_generator.py, pipeline.py Step 5)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Gemini — real, working fallback/alternative to Anthropic (was previously undocumented here — CP9 fix)
GEMINI_API_KEY=

# Qwen3 / DashScope — real, working fallback/alternative (OpenAI-compatible endpoint)
DASHSCOPE_API_KEY=
# Optional secondary DashScope key/endpoint (used as a second fallback slot if set)
DASHSCOPE_API_KEY_2=
DASHSCOPE_BASE_URL=
DASHSCOPE_BASE_URL_2=
DASHSCOPE_MODEL=
# Qwen3-TTS workspace endpoint (tools/tts/dashscope_voiceover.py — distinct from DASHSCOPE_BASE_URL above)
DASHSCOPE_API_URL=

# NOTE: the README's advertised "ChatGPT/GPT-4o" fallback tier has no corresponding
# OpenAI API call anywhere in generate_phase.py/text_content_generator.py today —
# do not assume OPENAI_API_KEY affects script generation until that is implemented
# (tracked as E11 in ARCHITECTURE_AUDIT.md / B2V2Docs/roadmap.md Phase 4).

# ── DATABASE (optional — PostgreSQL shadow index; app runs fine without it) ──
# db/db.py, db/migrate.py, install.py all read these; omit entirely to run file-only
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bhrikutyflimdirector
DB_USER=postgres
DB_PASSWORD=

# ── MUSIC (optional — free-tier MusicProvider, tools/audio/music_provider.py) ──
# TWO tiers, both supported, neither required:
#   Tier A - MANUAL: download a track yourself (e.g. from pixabay.com/music/ —
#            Pixabay has no public Music API, so this is a manual download,
#            not an integration) and drop it into phase_N/music/manual/.
#            No key needed; checked first if present.
#   Tier B - JAMENDO: automated free API (register at https://developer.jamendo.com/),
#            used only if no manual file is present in music/manual/.
# Either tier writes phase_N/music/background_music.mp3. Skipped gracefully if neither applies.
JAMENDO_CLIENT_ID=

# ── TTS / VOICEOVER (pick one or more) ────────────────
# ElevenLabs — paid, industry standard, best quality
ELEVENLABS_API_KEY=

# Chatterbox + Kokoro run fully locally — no API key needed

# ── VIDEO RENDERING (optional override) ───────────────
# Only relevant if using tools/video/remotion_composer.py's external-scene path —
# defaults to a sibling directory OUTSIDE this repo (D:\claude_project\LearnRemotion\out).
# See B2V2Docs/architecture.md §2 for why this path is a flagged architectural seam.
REMOTION_OUT_DIR=

# ── RESERVED — cataloged for a planned feature, NOT yet called by any code path ──
# (see B2V2Docs/roadmap.md Phase 5 — BRollProvider/MusicProvider/BackgroundMatteProvider).
# Setting these today has no effect until that phase ships.

# TRANSCRIPTION (planned — faster-whisper runs free locally today, no key needed)
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
GLADIA_API_KEY=

# IMAGE GENERATION (planned)
BFL_API_KEY=
IDEOGRAM_API_KEY=
OPENAI_API_KEY=

# VIDEO B-ROLL (planned — BRollProvider paid tier)
RUNWAY_API_KEY=
KLING_API_KEY=

# CLOUD RENDERING (planned)
CREATOMATE_API_KEY=

# ── SOCIAL MEDIA PUBLISHING ────────────────────────────
# YouTube — Google OAuth 2.0 (YouTube Data API v3) — IMPLEMENTED
# Download client_secrets.json from console.cloud.google.com
# → APIs & Services → OAuth 2.0 → Desktop App credentials
# Free — 10,000 units/day (~6 uploads/day)
# Tools: pip install google-api-python-client google-auth-oauthlib
# Script: python tools/publish/publish_youtube.py --project X --phase N

# TikTok — Content Posting API (for Business accounts)
# https://developers.tiktok.com/products/content-posting-api/
# TIKTOK_API_KEY is IMPLEMENTED (tools/publish/publish_platform.py, bearer-token flow).
# TIKTOK_CLIENT_ID/SECRET are RESERVED — no OAuth client flow reads them today.
TIKTOK_API_KEY=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Instagram / Meta Graph API — IMPLEMENTED (tools/publish/publish_platform.py)
# https://developers.facebook.com/docs/instagram-api/guides/content-publishing
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_VIDEO_URL must be a public CDN URL for video upload (not a local path)
INSTAGRAM_VIDEO_URL=

# Twitter / X API v2 — Free tier: 1,500 tweets/month — IMPLEMENTED
# https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Tools: pip install tweepy

# LinkedIn Marketing API — IMPLEMENTED (LINKEDIN_ACCESS_TOKEN/LINKEDIN_PERSON_ID);
# LINKEDIN_ORGANIZATION_ID is RESERVED — not read by any code path today
# https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
LINKEDIN_ORGANIZATION_ID=

# ── SOCIAL MEDIA RESEARCH (Apify) — IMPLEMENTED ───────
# 3,268 scraping actors for trend research, competitor analysis, hashtag data
# Free tier: $5 credit/month (~50 research runs)
# Get token: https://console.apify.com/account/integrations
# Tools: pip install apify-client
# Script: python tools/research/apify_trends.py --topic "economics" --platform tiktok
APIFY_API_TOKEN=
