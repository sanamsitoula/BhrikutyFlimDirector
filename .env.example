# Bhrikuty — Environment Variables
# Copy this file to .env and fill in your keys
# Never commit .env to git

# ── REQUIRED ──────────────────────────────────────────
# Script generation + text content (generate_phase.py, text_content_generator.py)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── TTS / VOICEOVER (pick one or more) ────────────────
# ElevenLabs — paid, industry standard, best quality
ELEVENLABS_API_KEY=

# Qwen3-TTS / DashScope — current default, freemium
DASHSCOPE_API_KEY=

# Chatterbox + Kokoro run fully locally — no API key needed

# ── TRANSCRIPTION (optional — faster-whisper runs free locally) ───
# AssemblyAI — paid, ~$0.03/video, includes auto YouTube chapters
ASSEMBLYAI_API_KEY=

# Deepgram — paid, lowest latency, best for live streams
DEEPGRAM_API_KEY=

# Gladia — paid, ~$0.04/video, includes 100-language translation
GLADIA_API_KEY=

# ── IMAGE GENERATION (optional) ───────────────────────
# FLUX.1 pro via BFL API — ~$0.055/image, no local GPU needed
BFL_API_KEY=

# Ideogram v2 — best text-in-image, ~$0.08/image
IDEOGRAM_API_KEY=

# OpenAI — DALL-E 3, ~$0.04/image
OPENAI_API_KEY=

# ── VIDEO B-ROLL (optional) ───────────────────────────
# Runway Gen-4 — cinematic AI B-roll, ~$0.05/sec
RUNWAY_API_KEY=

# Kling AI — best cost/quality B-roll, $7.99/mo
KLING_API_KEY=

# ── CLOUD RENDERING (optional) ────────────────────────
# Creatomate — JSON template video rendering, ~$0.38/min
CREATOMATE_API_KEY=

# ── SOCIAL MEDIA PUBLISHING ────────────────────────────
# YouTube — Google OAuth 2.0 (YouTube Data API v3)
# Download client_secrets.json from console.cloud.google.com
# → APIs & Services → OAuth 2.0 → Desktop App credentials
# Free — 10,000 units/day (~6 uploads/day)
# Tools: pip install google-api-python-client google-auth-oauthlib
# Script: python tools/publish/publish_youtube.py --project X --phase N

# TikTok — Content Posting API (for Business accounts)
# https://developers.tiktok.com/products/content-posting-api/
TIKTOK_API_KEY=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Instagram / Meta Graph API
# https://developers.facebook.com/docs/instagram-api/guides/content-publishing
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_VIDEO_URL must be a public CDN URL for video upload (not a local path)
INSTAGRAM_VIDEO_URL=

# Twitter / X API v2 — Free tier: 1,500 tweets/month
# https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Tools: pip install tweepy

# LinkedIn Marketing API
# https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
LINKEDIN_ORGANIZATION_ID=

# ── SOCIAL MEDIA RESEARCH (Apify) ─────────────────────
# 3,268 scraping actors for trend research, competitor analysis, hashtag data
# Free tier: $5 credit/month (~50 research runs)
# Get token: https://console.apify.com/account/integrations
# Tools: pip install apify-client
# Script: python tools/research/apify_trends.py --topic "economics" --platform tiktok
APIFY_API_TOKEN=
