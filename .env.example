# Bhrikuty — Environment Variables
# Copy this file to .env and fill in your keys
# Never commit .env to git

# ── REQUIRED ──────────────────────────────────────────
# Script generation + text content (generate_phase.py, text_content_generator.py)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── TTS / VOICEOVER (pick one or more) ────────────────
# ElevenLabs — paid, industry standard, best quality
ELEVENLABS_API_KEY=

# Qwen3-TTS / DashScope — current default, freemium
DASHSCOPE_API_KEY=

# Chatterbox + Kokoro run fully locally — no API key needed

# ── TRANSCRIPTION (optional — faster-whisper runs free locally) ───
# AssemblyAI — paid, ~$0.03/video, includes auto YouTube chapters
ASSEMBLYAI_API_KEY=

# Deepgram — paid, lowest latency, best for live streams
DEEPGRAM_API_KEY=

# Gladia — paid, ~$0.04/video, includes 100-language translation
GLADIA_API_KEY=

# ── IMAGE GENERATION (optional) ───────────────────────
# FLUX.1 pro via BFL API — ~$0.055/image, no local GPU needed
BFL_API_KEY=

# Ideogram v2 — best text-in-image, ~$0.08/image
IDEOGRAM_API_KEY=

# OpenAI — DALL-E 3, ~$0.04/image
OPENAI_API_KEY=

# ── VIDEO B-ROLL (optional) ───────────────────────────
# Runway Gen-4 — cinematic AI B-roll, ~$0.05/sec
RUNWAY_API_KEY=

# Kling AI — best cost/quality B-roll, $7.99/mo
KLING_API_KEY=

# ── CLOUD RENDERING (optional) ────────────────────────
# Creatomate — JSON template video rendering, ~$0.38/min
CREATOMATE_API_KEY=
